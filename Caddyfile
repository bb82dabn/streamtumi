{$APP_DOMAIN:localhost} {
	encode zstd gzip

	handle {
		reverse_proxy app:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}

	@secret_bearing_routes path /api/public/stations/* /watch/* /listen/* /reset-password* /verify-email* /activate* /api/device/*
	log_skip @secret_bearing_routes

	log {
		output stdout
		format filter {
			request>uri query {
				replace grant REDACTED
			}
			wrap json
		}
	}
}
