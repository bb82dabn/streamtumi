{
  "name": "@streamtumi/mobile",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bb82dabn/streamtumi.git",
    "directory": "apps/mobile"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "EXPO_NO_TELEMETRY=1 DO_NOT_TRACK=1 expo start",
    "android": "EXPO_NO_TELEMETRY=1 DO_NOT_TRACK=1 expo start --android",
    "ios": "EXPO_NO_TELEMETRY=1 DO_NOT_TRACK=1 expo start --ios",
    "web": "EXPO_NO_TELEMETRY=1 DO_NOT_TRACK=1 expo start --web",
    "lint": "EXPO_NO_TELEMETRY=1 DO_NOT_TRACK=1 expo lint",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/*.test.mjs",
    "doctor": "EXPO_NO_TELEMETRY=1 DO_NOT_TRACK=1 npx --yes expo-doctor@1.20.2",
    "config": "EXPO_NO_TELEMETRY=1 DO_NOT_TRACK=1 expo config --type public --json",
    "check": "npm run typecheck && npm run lint && npm test && npm run doctor && npm run config"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.11",
    "@expo/vector-icons": "^15.1.1",
    "@streamtumi/contracts": "file:../../packages/contracts",
    "expo": "~57.0.24",
    "expo-asset": "~57.0.12",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.21",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-font": "~57.0.1",
    "expo-image-picker": "~57.0.19",
    "expo-linking": "~58.0.4",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "image-size": "2.0.4"
  }
}
