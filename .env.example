# Canonical public origin. Production requires HTTPS.
APP_URL=https://streamtumi.example.com
APP_DOMAIN=streamtumi.example.com
APP_INTERNAL_HOSTS=streamtumi-internal
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000
APP_SECRET=replace-with-at-least-48-random-characters

# For a loopback-only evaluation set APP_URL=http://localhost:3000 and this to true.
ALLOW_INSECURE_HTTP=false
REGISTRATION_ENABLED=false

# Bundled PostgreSQL, Valkey, and MinIO.
POSTGRES_USER=streamtumi
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_DB=streamtumi
DATABASE_URL=
REDIS_URL=
MINIO_ROOT_USER=streamtumi
MINIO_ROOT_PASSWORD=replace-with-a-random-object-storage-password
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=minio
S3_PORT=9000
S3_USE_SSL=false
S3_REGION=us-east-1
S3_ACCESS_KEY=streamtumi
S3_SECRET_KEY=replace-with-the-object-storage-password
S3_BUCKET=streamtumi

# Optional SMTP. Leave SMTP_HOST blank to disable email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=StreamTumi <no-reply@streamtumi.example.com>

# Optional mobile universal-link association values.
APPLE_APP_ID=
ANDROID_APP_CERT_SHA256=

# Upload and optional YouTube import policy.
MAX_UPLOAD_BYTES=2147483648
YOUTUBE_IMPORT_ENABLED=false
YOUTUBE_IMPORT_MAX_DURATION_SECONDS=21600
YOUTUBE_IMPORT_METADATA_TIMEOUT_SECONDS=60
YOUTUBE_IMPORT_DOWNLOAD_TIMEOUT_SECONDS=3600

# Sessions, cache, retention, and lifecycle.
SESSION_TTL_DAYS=30
GUIDE_CATALOG_CACHE_SECONDS=5
CHAT_RETENTION_DAYS=30
REPORT_RETENTION_DAYS=365
STATION_DELETE_GRACE_DAYS=7

# CPU is the default. Use compose.gpu.yaml to opt into NVIDIA acceleration.
TRANSCODE_ACCELERATION=cpu
TRANSCODE_CONCURRENCY=1
TRANSCODE_NVENC_PRESET=p1
TRANSCODE_CPU_PRESET=veryfast
TRANSCODE_DOWNLOAD_CONCURRENCY=4
TRANSCODE_UPLOAD_CONCURRENCY=4

# Local radio processing and playout.
RADIO_PREP_CONCURRENCY=1
RADIO_PREP_TIMEOUT_SECONDS=7200
RADIO_TRACK_MAX_DURATION_SECONDS=21600
RADIO_PLAYOUT_MAX_STATIONS=2
RADIO_PLAYOUT_LEASE_SECONDS=20
RADIO_PLAYOUT_RECONCILE_SECONDS=5
RADIO_HLS_SEGMENT_SECONDS=4
RADIO_STATIC_HLS_SEGMENT_SECONDS=1

# Local TV channel playout.
TV_PLAYOUT_MAX_STATIONS=2
TV_PLAYOUT_LEASE_SECONDS=20
TV_PLAYOUT_RECONCILE_SECONDS=2
TV_SEGMENT_JOURNAL_RETENTION_DAYS=7

# Optional vendored WeatherStar 4000+ profile.
WEATHERSTAR_URL=http://ws4kp:8080
WEATHER_RENDER_CONCURRENCY=2
WEATHER_RENDER_IDLE_SECONDS=300
WEATHER_RENDER_STARTUP_SECONDS=120
WEATHER_RENDER_FRAME_RATE=10
WEATHER_CHROMIUM_PATH=/usr/bin/chromium
WEATHER_CHANNEL_OWNER_EMAIL=
