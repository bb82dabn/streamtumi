{
  "name": "streamtumi",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bb82dabn/streamtumi.git"
  },
  "bugs": {
    "url": "https://github.com/bb82dabn/streamtumi/issues"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev",
    "worker": "tsx src-worker.ts",
    "media-worker": "tsx src-media-worker.ts",
    "radio-worker": "tsx src-radio-worker.ts",
    "radio-playout": "tsx src-radio-playout.ts",
    "tv-playout": "tsx src-tv-playout.ts",
    "weather-renderer": "tsx src-weather-renderer.ts",
    "weather:provision": "tsx scripts/provision-weather-channel.ts",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build --webpack",
    "brand:check": "node scripts/generate-brand-assets.mjs --check",
    "brand:generate": "node scripts/generate-brand-assets.mjs",
    "start": "next start",
    "lint": "eslint app components e2e lib scripts tests proxy.ts src-worker.ts src-media-worker.ts src-radio-worker.ts src-radio-playout.ts src-tv-playout.ts src-weather-renderer.ts next.config.ts playwright.config.ts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "media:backfill": "tsx scripts/backfill-media-assets.ts",
    "radio:backfill-hls": "tsx scripts/backfill-radio-hls.ts",
    "tv:backfill-derivatives": "tsx scripts/backfill-tv-channel-derivatives.ts",
    "tv:prepare-transition": "tsx scripts/prepare-tv-transition.ts",
    "tv:activate-channel": "tsx scripts/activate-tv-channel.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "admin:reset-password": "tsx scripts/reset-admin-password.ts",
    "user:set-role": "tsx scripts/set-user-role.ts",
    "sample:media": "bash scripts/generate-sample-media.sh",
    "roku:check": "bsc --project roku/bsconfig.json --noEmit --copy-to-staging false",
    "roku:package": "bsc --project roku/bsconfig.json --create-package",
    "roku:deploy": "bsc --project roku/bsconfig.json --create-package --deploy --host \"$ROKU_DEV_TARGET\" --password \"$ROKU_DEV_PASSWORD\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@js-temporal/polyfill": "^0.5.1",
    "bcryptjs": "^3.0.2",
    "bullmq": "^6.1.1",
    "file-type": "^21.0.0",
    "hls.js": "^1.7.0",
    "ioredis": "^5.7.0",
    "lucide-react": "^0.539.0",
    "minio": "^8.0.5",
    "next": "16.3.5",
    "nodemailer": "^10.0.10",
    "pg": "^8.16.3",
    "playwright-core": "^1.62.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.4",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.17.1",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "brighterscript": "0.73.5",
    "eslint": "^9.33.0",
    "eslint-config-next": "16.3.1",
    "roku-deploy": "3.18.2",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "4.1.11"
  }
}
